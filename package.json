{
  "name": "plantar-pressure",
  "private": true,
  "version": "1.0.21",
  "description": "Harris Mat image-based plantar pressure analysis system",
  "author": "Technomind Healthcare Systems",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "concurrently \"vite --port 5200\" \"wait-on http://localhost:5200 && electron electron/main.cjs\"",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "mobile:sync": "vite build && npx cap sync",
    "mobile:ios": "vite build && npx cap open ios",
    "mobile:android": "vite build && npx cap open android",
    "bump:patch": "node scripts/bump_version.cjs patch",
    "bump:minor": "node scripts/bump_version.cjs minor",
    "bump:major": "node scripts/bump_version.cjs major",
    "test:validate": "node scripts/validate_system.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
